# =========================
# Delta Control Tower
# =========================

# Deployment boundary. Keep `combined` on the existing production project
# until the domains have been migrated to their independent Vercel projects.
# Partner Platform project: partner-platform
# Telahagocrecer project: telahagocrecer
DEPLOYMENT_SURFACE=combined

# --- Google Sheets (required for Sheet Explorer / Activation helper) ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_COUNTY_TAB=Counties
GOOGLE_SHEET_CITY_TAB=Cities

# Google auth (use ONE approach)
# 1) Service account keyfile (recommended for server routes):
GOOGLE_SERVICE_ACCOUNT_KEYFILE=../resources/config/google-cloud.json

# 2) OR service account inline:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3) OR OAuth JSON (optional in other flows):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- GSC OAuth (optional; used as preferred auth for Search Console submits if set) ---
GSC_TOKENS_FILE=../resources/config/gsc_tokens.json
GSC_OAUTH_CLIENT_FILE=../resources/config/gsc_oauth_client.json

# =========================
# Indexing / Submission
# =========================

# --- Google domain indexing check (Search Console inspection) ---
INDEX_GOOGLE_ENABLED=true

# --- IndexNow via the private My Drip Nurse Cloudflare Worker ---
# Server-only bearer token shared with the Worker. Never prefix with NEXT_PUBLIC_.
INDEXNOW_WORKER_SUBMIT_TOKEN=
# Optional override; the production Worker URL is used when left empty.
INDEXNOW_WORKER_SUBMIT_URL=https://mydripnurse-indexnow.ac-e6b.workers.dev/submit

# =========================
# Domain Bot (production browser worker)
# =========================
# Auto mode (default): uses remote worker when DOMAIN_BOT_WORKER_URL is set; otherwise local mode.
DOMAIN_BOT_MODE=auto
# Remote endpoint that executes browser actions (Playwright/CDP worker).
# Example: https://your-browser-worker.example.com/run
DOMAIN_BOT_WORKER_URL=
# Optional auth token for the remote worker.
DOMAIN_BOT_WORKER_API_KEY=
# Optional request timeout to worker in ms.
DOMAIN_BOT_WORKER_TIMEOUT_MS=420000

# =========================
# Runner Worker (Railway offload for long jobs)
# =========================
# If RUNNER_WORKER_URL is set, /api/run can delegate selected jobs to Railway worker.
RUNNER_REMOTE_ENABLED=1
RUNNER_REMOTE_JOBS=run-delta-system
RUNNER_REMOTE_FALLBACK_LOCAL=1
RUNNER_WORKER_URL=
RUNNER_WORKER_API_KEY=
RUNNER_WORKER_DELEGATE_TIMEOUT_MS=30000
RUNNER_WORKER_STOP_TIMEOUT_MS=20000

# SSE stream tuning (optional)
RUN_STREAM_TICK_MS=800
RUN_STREAM_DB_TICK_MS=1200
RUN_STREAM_DB_ERROR_TICK_MS=1800
RUN_STREAM_NOT_FOUND_GRACE_TICKS=25

# =========================
# Ads AI Notifications
# =========================
# Scheduler guard key for:
# POST /api/dashboard/ads/notifications/cron
ADS_NOTIF_CRON_KEY=

# Optional Slack incoming webhook for high/critical alerts
ADS_ALERT_SLACK_WEBHOOK_URL=

# Optional generic email workflow webhook (Zapier/Make/your mail worker)
ADS_ALERT_EMAIL_WEBHOOK_URL=

# Optional global GoHighLevel webhook fallback (if tenant-level webhook is not set)
ADS_ALERT_GHL_WEBHOOK_URL=

# =========================
# Prospecting / Hard Refresh
# =========================
# Google Places / Maps key fallback (tenant integration can override this)
GOOGLE_MAPS_API_KEY=
# Optional alias used by some flows
GOOGLE_PLACES_API_KEY=

# Public Mapbox token for the Partner directory's interactive map.
# Create a token at https://account.mapbox.com/access-tokens/ and add it to Vercel as NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Published Mapbox Studio style used by the directory map.
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/devasks/cmskkxgku012r01s6bbfjbwxn

# Cron auth secret (recommended single secret for all internal cron endpoints)
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Keep auto-approval off for semi-autonomous mode (manual approve/reject).
AGENT_ALLOW_AUTO_APPROVAL=0

# =========================
# Partner Onboarding
# =========================
# Server-only 32-byte key encoded as 64 hex characters or base64url.
PARTNER_ONBOARDING_ENCRYPTION_KEY=
# Full public URL of the GHL landing page. Falls back to APP_URL/partner-welcome.
PARTNER_WELCOME_BASE_URL=

# =========================
# My Drip Nurse Booking + Stripe
# =========================
# Server-only Stripe key used to create deposit Checkout Sessions.
STRIPE_SECRET_KEY=
# Signing secret for POST /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# Public booking application origin; no trailing slash.
BOOKING_PUBLIC_BASE_URL=https://booking.mydripnurse.com

# Optional legacy aliases (if CRON_SECRET is not used)
# DASHBOARD_CRON_SECRET=
# PROSPECTING_CRON_SECRET=

# =========================
# Runway (YouTube Ads Video Studio)
# =========================
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_MODEL=gen4.5
RUNWAY_API_VERSION=2024-11-06
